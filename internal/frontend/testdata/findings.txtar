-- findings.go --
package findings

import (
	"bytes"
	"sync"
)

var pool = sync.Pool{New: func() any { return new(bytes.Buffer) }}

func Bad(p string) {
	buf := pool.Get().(*bytes.Buffer)
	pool.Put(buf)
	buf.WriteString(p)
}
